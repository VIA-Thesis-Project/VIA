# Provider-neutral production runtime example. Supply real secrets through the
# deployment platform or secret manager; do not commit them to this file.

# API / shared persistence. Production requires all three repositories to use PostgreSQL.
VIA_DATABASE_URL=postgresql+psycopg://via:change-me@postgresql:5432/via
VIA_FARM_MANAGEMENT_REPOSITORY=postgresql
VIA_ENVIRONMENTAL_INFORMATION_REPOSITORY=postgresql
VIA_AGROCLIMATIC_EVALUATION_REPOSITORY=postgresql

# Worker polling.
VIA_WORKER_POLL_INTERVAL_SECONDS=5
VIA_WORKER_BATCH_SIZE=1

# Worker scientific runtime. These are deployment-provided absolute paths.
VIA_CROPSUITE_ROOT=/opt/via/CropSuiteLite
VIA_CROPSUITE_PYTHON=/usr/local/bin/python
VIA_CROPSUITE_WORKSPACE=/var/lib/via/workspace
VIA_ARTIFACTS_ROOT=/var/lib/via/artifacts
VIA_CROPSUITE_INPUT_BINDINGS=/etc/via/input-bindings.json
# Optional according to the current worker configuration.
VIA_CROPSUITE_SOURCE_CONFIG=
VIA_CROPSUITE_CATALOG=
VIA_CROPSUITE_MAX_WORKERS=2

# VIA_POSTGRES_* belongs to the local compose example, not the production API/worker.
# VIA_TEST_DATABASE_URL and VIA_ALLOW_EXTERNAL_TEST_DATABASE are test-only variables.
