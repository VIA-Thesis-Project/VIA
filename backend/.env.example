# Local development example. Do not copy these placeholder credentials to production.

# API / shared persistence. When VIA_DATABASE_URL is absent, Settings.from_env()
# intentionally falls back to in-memory repositories for development.
VIA_API_HOST=0.0.0.0
VIA_API_PORT=8000
VIA_FARM_MANAGEMENT_REPOSITORY=postgresql
VIA_ENVIRONMENTAL_INFORMATION_REPOSITORY=postgresql
VIA_AGROCLIMATIC_EVALUATION_REPOSITORY=postgresql
VIA_DATABASE_URL=postgresql+psycopg://via:change-me@localhost:5432/via_test
# Optional source-layout override. via-migrate otherwise resolves backend/alembic.ini
# relative to its source module, without depending on the current working directory.
# VIA_ALEMBIC_CONFIG=C:\\path\\to\\backend\\alembic.ini

# Worker runtime.
VIA_WORKER_POLL_INTERVAL_SECONDS=5
VIA_WORKER_BATCH_SIZE=1
VIA_CROPSUITE_ROOT=C:\\path\\to\\CropSuiteLite
VIA_CROPSUITE_PYTHON=C:\\path\\to\\scientific-python.exe
VIA_CROPSUITE_WORKSPACE=C:\\path\\to\\via-worker-workspace
VIA_ARTIFACTS_ROOT=C:\\path\\to\\via-artifacts
VIA_CROPSUITE_INPUT_BINDINGS=C:\\path\\to\\input-bindings.json
# Optional worker inputs. Leave blank when the current deployment does not use them.
VIA_CROPSUITE_SOURCE_CONFIG=
VIA_CROPSUITE_CATALOG=
VIA_CROPSUITE_MAX_WORKERS=2

# Local PostGIS compose only.
VIA_POSTGRES_DB=via_test
VIA_POSTGRES_USER=via
VIA_POSTGRES_PASSWORD=change-me
VIA_POSTGRES_PORT=5432

# Tests only. These are not production runtime variables.
VIA_TEST_DATABASE_URL=postgresql+psycopg://via:change-me@localhost:5432/via_test
# Set to 1 only for a dedicated, disposable managed test database whose name
# cannot end in _test. Integration-test support is the only consumer.
VIA_ALLOW_EXTERNAL_TEST_DATABASE=0
