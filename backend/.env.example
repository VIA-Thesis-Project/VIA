# Local-only example values. Replace the password before using a shared environment.
VIA_FARM_MANAGEMENT_REPOSITORY=postgresql
VIA_ENVIRONMENTAL_INFORMATION_REPOSITORY=postgresql
VIA_AGROCLIMATIC_EVALUATION_REPOSITORY=postgresql
VIA_DATABASE_URL=postgresql+psycopg://via:change-me@localhost:5432/via_test
VIA_TEST_DATABASE_URL=postgresql+psycopg://via:change-me@localhost:5432/via_test
# Set to 1 only for a dedicated, disposable managed test database whose name
# cannot end in _test. This opt-in is read only by integration-test support.
VIA_ALLOW_EXTERNAL_TEST_DATABASE=0
VIA_POSTGRES_DB=via_test
VIA_POSTGRES_USER=via
VIA_POSTGRES_PASSWORD=change-me
VIA_POSTGRES_PORT=5432
