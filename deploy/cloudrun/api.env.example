# Cloud Run injects PORT. Leave VIA_API_PORT unset so via-api consumes PORT.
VIA_API_HOST=0.0.0.0

# Supply this from Secret Manager using the Supabase transaction pooler URL.
VIA_API_DATABASE_URL=REPLACE_WITH_SUPABASE_TRANSACTION_POOLER_URL
VIA_API_DATABASE_POOL_SIZE=5
VIA_API_DATABASE_MAX_OVERFLOW=0
VIA_API_DATABASE_POOL_TIMEOUT_SECONDS=30
VIA_API_DATABASE_POOL_RECYCLE_SECONDS=300

VIA_FARM_MANAGEMENT_REPOSITORY=postgresql
VIA_ENVIRONMENTAL_INFORMATION_REPOSITORY=postgresql
VIA_AGROCLIMATIC_EVALUATION_REPOSITORY=postgresql

# Capability discovery needs the reviewed scientific binding manifest and the
# CropSuite crop catalog, but it does not need the raw scientific rasters.
# Mount the small input-bindings.json as Cloud Run configuration at /etc/via.
VIA_CROPSUITE_INPUT_BINDINGS=/etc/via/input-bindings.json
VIA_CROPSUITE_CATALOG=/opt/via/CropSuiteLite/plant_params/huaura_maize

VIA_CORS_ALLOWED_ORIGINS=REPLACE_WITH_FRONTEND_HTTPS_ORIGIN
VIA_AUTH_ACCESS_TOKEN_TTL_SECONDS=900
VIA_AUTH_REFRESH_TOKEN_TTL_SECONDS=1209600
VIA_AUTH_REFRESH_COOKIE_NAME=__Secure-via_refresh
VIA_AUTH_REFRESH_COOKIE_SECURE=true
VIA_AUTH_REFRESH_COOKIE_SAMESITE=lax

# The packaged knowledge manifest/taxonomy are sufficient for serving. External
# PDFs are consumed by the separate via-knowledge ingestion command.
VIA_OPENAI_API_KEY=REPLACE_WITH_SECRET_MANAGER_OPENAI_SECRET
