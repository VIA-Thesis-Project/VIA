# One-shot Cloud Run Job settings for via-migrate upgrade.
# Supply this from Secret Manager. Prefer the direct Supabase database endpoint
# for migrations; use an appropriate session endpoint if direct connectivity is unavailable.
VIA_MIGRATION_DATABASE_URL=REPLACE_WITH_SUPABASE_MIGRATION_DATABASE_URL
VIA_FARM_MANAGEMENT_REPOSITORY=postgresql
VIA_ENVIRONMENTAL_INFORMATION_REPOSITORY=postgresql
VIA_AGROCLIMATIC_EVALUATION_REPOSITORY=postgresql
