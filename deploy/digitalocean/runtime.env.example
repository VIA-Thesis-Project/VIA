# Copy to /srv/via/config/runtime.env on the Droplet and chmod 600.
# Keep the real file off Git. The deployment script requires a URL-unreserved
# password of at least 24 characters so the same secret can safely construct
# VIA_DATABASE_URL without storing a second password representation.

VIA_POSTGRES_DB=via
VIA_POSTGRES_USER=via
VIA_POSTGRES_PASSWORD=REPLACE_ME

# One deployment worker processes one evaluation at a time at the VIA queue level.
VIA_WORKER_BATCH_SIZE=1
VIA_WORKER_POLL_INTERVAL_SECONDS=5

# Optional CropSuite runtime inputs. SOURCE_CONFIG is a read-only file and CATALOG
# is a read-only directory of .inf files. Mount them under /etc/via, or leave the
# variables empty to use runtime/image defaults when available.
VIA_CROPSUITE_SOURCE_CONFIG=/etc/via/source-config.ini
VIA_CROPSUITE_CATALOG=/etc/via/catalog

# The initial 1 vCPU Droplet keeps CropSuite scientific execution single-worker.
VIA_CROPSUITE_MAX_WORKERS=1
