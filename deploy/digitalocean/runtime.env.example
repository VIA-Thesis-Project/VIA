# Copy to /srv/via/config/runtime.env on the Droplet and chmod 600.
# Keep the real file off Git. The deployment script requires a URL-unreserved
# password of at least 24 characters so the same secret can safely construct
# VIA_DATABASE_URL without storing a second password representation.

VIA_POSTGRES_DB=via
VIA_POSTGRES_USER=via
VIA_POSTGRES_PASSWORD=REPLACE_ME

# Comma-separated browser origins allowed by the API. Replace this marker with the
# real HTTPS frontend origin before deployment. Wildcard (*) is rejected.
VIA_CORS_ALLOWED_ORIGINS=REPLACE_WITH_FRONTEND_HTTPS_ORIGIN

# Authentication/session defaults. Keep secure cookies enabled for the public HTTPS
# release. Override only when the deployment architecture explicitly requires it.
VIA_AUTH_ACCESS_TOKEN_TTL_SECONDS=900
VIA_AUTH_REFRESH_TOKEN_TTL_SECONDS=1209600
VIA_AUTH_REFRESH_COOKIE_NAME=__Secure-via_refresh
VIA_AUTH_REFRESH_COOKIE_SECURE=true
VIA_AUTH_REFRESH_COOKIE_SAMESITE=lax

# Public API abuse and cost controls.
VIA_RATE_LOGIN_PER_MINUTE=5
VIA_RATE_REFRESH_PER_MINUTE=10
VIA_RATE_DATASET_COVERAGE_PER_MINUTE=20
VIA_RATE_KNOWLEDGE_PER_USER_PER_MINUTE=30
VIA_RATE_RECOMMENDATIONS_PER_USER_PER_MINUTE=5
VIA_MAX_ACTIVE_EVALUATIONS_PER_USER=2
VIA_DAILY_EVALUATION_QUOTA_PER_USER=20
VIA_DAILY_RECOMMENDATION_QUOTA_PER_USER=10

# One deployment worker processes one evaluation at a time at the VIA queue level.
VIA_WORKER_BATCH_SIZE=1
VIA_WORKER_POLL_INTERVAL_SECONDS=5

# Huaura CropSuite runtime inputs. The source config is deployment-owned and
# mounted read-only under /etc/via; the validated maize catalog ships in the image.
VIA_CROPSUITE_SOURCE_CONFIG=/etc/via/huaura-runtime.ini
VIA_CROPSUITE_CATALOG=/opt/via/CropSuiteLite/plant_params/huaura_maize

# The initial 1 vCPU Droplet keeps CropSuite scientific execution single-worker.
VIA_CROPSUITE_MAX_WORKERS=1
