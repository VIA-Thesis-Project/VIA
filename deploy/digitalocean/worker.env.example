# Target worker-only DigitalOcean runtime.
# Copy to /srv/via/config/worker.env, fill secrets outside Git, and chmod 600.
# VIA_IMAGE is supplied per release as an immutable SHA tag or digest.

# Supabase endpoint appropriate for a long-running worker. Prefer the dashboard
# session/direct endpoint that is reachable from the Droplet.
VIA_WORKER_DATABASE_URL=REPLACE_WITH_SUPABASE_WORKER_DATABASE_URL
VIA_WORKER_DATABASE_POOL_SIZE=2
VIA_WORKER_DATABASE_MAX_OVERFLOW=0
VIA_WORKER_DATABASE_POOL_TIMEOUT_SECONDS=30
VIA_WORKER_DATABASE_POOL_RECYCLE_SECONDS=300

# Keep sequential execution until benchmark evidence supports a concurrency change.
VIA_WORKER_BATCH_SIZE=1
VIA_WORKER_POLL_INTERVAL_SECONDS=5
VIA_CROPSUITE_MAX_WORKERS=1
VIA_CROPSUITE_INPUT_BINDINGS=/etc/via/input-bindings.json
VIA_CROPSUITE_SOURCE_CONFIG=/etc/via/huaura-runtime.ini
VIA_CROPSUITE_CATALOG=/opt/via/CropSuiteLite/plant_params/huaura_maize

# Cloudflare R2 scientific sources.
VIA_SCIENTIFIC_SOURCE_BUCKET=REPLACE_WITH_R2_SOURCE_BUCKET
VIA_SCIENTIFIC_SOURCE_ENDPOINT=REPLACE_WITH_R2_S3_ENDPOINT
VIA_SCIENTIFIC_SOURCE_REGION=auto
VIA_SCIENTIFIC_SOURCE_ACCESS_KEY_ID=REPLACE_WITH_R2_SOURCE_ACCESS_KEY_ID
VIA_SCIENTIFIC_SOURCE_SECRET_ACCESS_KEY=REPLACE_WITH_R2_SOURCE_SECRET_ACCESS_KEY

# Cloudflare R2 scientific artifacts.
VIA_SCIENTIFIC_ARTIFACT_BUCKET=REPLACE_WITH_R2_ARTIFACT_BUCKET
VIA_SCIENTIFIC_ARTIFACT_ENDPOINT=REPLACE_WITH_R2_S3_ENDPOINT
VIA_SCIENTIFIC_ARTIFACT_REGION=auto
VIA_SCIENTIFIC_ARTIFACT_ACCESS_KEY_ID=REPLACE_WITH_R2_ARTIFACT_ACCESS_KEY_ID
VIA_SCIENTIFIC_ARTIFACT_SECRET_ACCESS_KEY=REPLACE_WITH_R2_ARTIFACT_SECRET_ACCESS_KEY
